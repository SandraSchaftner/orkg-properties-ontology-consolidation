orkg:P183191 a rdf:Property ;
    rdfs:label "research artifact"@en ;
    dcterms:created "2025-12-04T09:32:54.255504+01:00"^^xsd:dateTime ;
    dcterms:identifier "P183191" ;
    rdfs:comment "The 'research artifact' predicate refers to any tangible or digital object created or used during the research process that embodies the main contribution of the paper. This can include datasets, software, algorithms, models, experimental setups, or any other material that supports the research findings and enables reproducibility and further exploration."@en ;
    rdfs:isDefinedBy <https://w3id.org/orkg-properties-ontology-consolidated> ;
    skos:prefLabel "research artifact"@en .

orkg:P183192 a rdf:Property ;
