orkg:P191018 a rdf:Property ;
    rdfs:label "context efficiency"@en ;
    dcterms:created "2026-04-19T06:17:00.306686+02:00"^^xsd:dateTime ;
    dcterms:identifier "P191018" ;
    rdfs:comment "Context Efficiency refers to the effectiveness with which external tool outputs are incorporated into the LLM’s context window while minimizing unnecessary token consumption and redundancy. It evaluates how well the system optimizes context usage to maintain performance and reduce computational cost. In research, this property emphasizes innovations in context management, prompt optimization, or techniques that improve the balance between information richness and efficiency."@en ;
    rdfs:isDefinedBy <https://w3id.org/orkg-properties-ontology-consolidated> ;
    skos:prefLabel "context efficiency"@en .

