orkg:P184314 a rdf:Property ;
    rdfs:label "inductive study"@en ;
    dcterms:created "2026-01-13T15:23:38.913164+01:00"^^xsd:dateTime ;
    dcterms:identifier "P184314" ;
    rdfs:comment "Inductive Study refers to a research approach that involves collecting data and developing theories or generalizations based on observed patterns and evidence. It is a bottom-up method where conclusions are drawn from specific observations to broader generalizations, often used to generate new hypotheses or theories."@en ;
    rdfs:isDefinedBy <https://w3id.org/orkg-properties-ontology-consolidated> ;
    skos:prefLabel "inductive study"@en .

orkg:P184315 a rdf:Property ;
    rdfs:label "meta-analysis"@en ;
    dcterms:created "2026-01-13T15:24:01.130414+01:00"^^xsd:dateTime ;
    dcterms:identifier "P184315" ;
    rdfs:comment "Meta-analysis is a research method that systematically combines and analyzes data from multiple independent studies on a specific topic to derive overall conclusions, identify patterns, and assess the strength of evidence. It is used to provide a comprehensive and quantitative summary of existing research findings, enhancing the reliability and generalizability of results."@en ;
    rdfs:isDefinedBy <https://w3id.org/orkg-properties-ontology-consolidated> ;
    skos:prefLabel "meta-analysis"@en .

