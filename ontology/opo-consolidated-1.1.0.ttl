orkg:P184285 a rdf:Property ;
    rdfs:label "taxonomy"@en ;
    dcterms:created "2026-01-13T14:44:48.648208+01:00"^^xsd:dateTime ;
    dcterms:identifier "P184285" ;
    rdfs:comment "Taxonomy refers to the classification or categorization of entities within a particular domain, often used to organize concepts, objects, or data into a structured hierarchy. In the context of a research paper, identifying a taxonomy as a salient property indicates that the paper contributes by defining, proposing, or refining a systematic classification scheme relevant to its field of study."@en ;
    rdfs:isDefinedBy <https://w3id.org/orkg-properties-ontology-consolidated> ;
    skos:prefLabel "taxonomy"@en .

