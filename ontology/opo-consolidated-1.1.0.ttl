orkg:P166027 a rdf:Property ;
    rdfs:label "heat treatment"@en ;
    dcterms:created "2025-03-17T14:11:25.015604+01:00"^^xsd:dateTime ;
    dcterms:identifier "P166027" ;
    rdfs:comment "The predicate 'heat treatment' refers to the process of subjecting a material to controlled heating and cooling to alter its microstructure and properties. In the context of the paper titled 'Effects of process parameters on interfacial characterization and mechanical properties of 316L/CuCrZr functionally graded material by selective laser melting', heat treatment plays a key role in understanding how heat processing affects the interfacial characteristics and mechanical properties of the functionally graded material fabricated using selective laser melting."@en ;
    rdfs:isDefinedBy <https://w3id.org/orkg-properties-ontology-consolidated> ;
    skos:prefLabel "heat treatment"@en .

