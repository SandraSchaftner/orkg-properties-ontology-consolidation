orkg:P184272 a rdf:Property ;
    rdfs:label "controlled experiment"@en ;
    dcterms:created "2026-01-13T14:25:19.546123+01:00"^^xsd:dateTime ;
    dcterms:identifier "P184272" ;
    rdfs:comment "A Controlled Experiment is a scientific study where one or more variables are manipulated while others are kept constant to determine the effect of the manipulated variables. It involves the use of control groups and experimental groups to establish causal relationships and validate hypotheses. This property indicates that the research contribution includes empirical evidence obtained through such rigorously designed experiments."@en ;
    rdfs:isDefinedBy <https://w3id.org/orkg-properties-ontology-consolidated> ;
    skos:prefLabel "controlled experiment"@en .

orkg:P184273 a rdf:Property ;
