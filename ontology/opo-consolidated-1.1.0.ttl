orkg:P184280 a rdf:Property ;
    rdfs:label "lab experiment"@en ;
    dcterms:created "2026-01-13T14:35:20.448970+01:00"^^xsd:dateTime ;
    dcterms:identifier "P184280" ;
    rdfs:comment "Lab Experiment refers to a research method involving controlled and systematic investigation conducted in a laboratory setting. It is used to test hypotheses, observe phenomena, and gather empirical data under controlled conditions. This property highlights that the research contribution includes experimental work carried out in a lab environment, emphasizing the empirical and reproducible nature of the study."@en ;
    rdfs:isDefinedBy <https://w3id.org/orkg-properties-ontology-consolidated> ;
    skos:prefLabel "lab experiment"@en .

orkg:P184281 a rdf:Property ;
    rdfs:label "Design Science / Engineering" ;
    owl:equivalentProperty orkg:P41267 ;
