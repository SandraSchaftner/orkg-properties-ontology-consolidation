orkg:P184276 a rdf:Property ;
    rdfs:label "technical experiment"@en ;
    dcterms:created "2026-01-13T14:27:41.452936+01:00"^^xsd:dateTime ;
    dcterms:identifier "P184276" ;
    rdfs:comment "Technical Experiment refers to a systematic and controlled procedure carried out to validate, demonstrate, or evaluate a technical concept, method, or system presented in a research paper. It involves the practical implementation and testing of hypotheses or technologies to provide empirical evidence supporting the research contribution."@en ;
    rdfs:isDefinedBy <https://w3id.org/orkg-properties-ontology-consolidated> ;
    skos:prefLabel "technical experiment"@en .

