orkg:P173037 a rdf:Property ;
    rdfs:label "research-based criteria"@en ;
    dcterms:created "2025-05-04T12:38:29.824102+02:00"^^xsd:dateTime ;
    dcterms:identifier "P173037" ;
    rdfs:comment "Research-based land-use exclusion criteria refer to the specific factors or conditions determined through research that dictate areas where certain land uses, such as wind farm development, should be prohibited or restricted. In the context of the paper titled 'A global wind farm potential index to increase energy yields and accessibility', this predicate signifies the criteria established through research to exclude certain land areas from wind farm development to optimize energy production and accessibility."@en ;
    rdfs:isDefinedBy <https://w3id.org/orkg-properties-ontology-consolidated> ;
    skos:prefLabel "research-based criteria"@en .

