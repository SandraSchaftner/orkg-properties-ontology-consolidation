    dcterms:created "2025-12-04T09:36:22.266470+01:00"^^xsd:dateTime ;
    dcterms:identifier "P183192" ;
    rdfs:comment "Research components refer to the key elements or parts of a research study that collectively contribute to the overall research contribution. These components include the theory type, emphasis, formal concepts, independed variables etc. Identifying and describing these components helps in understanding the structure and significance of the research work."@en ;
    rdfs:isDefinedBy <https://w3id.org/orkg-properties-ontology-consolidated> ;
