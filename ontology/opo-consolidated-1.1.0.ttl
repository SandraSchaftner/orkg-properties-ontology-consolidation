orkg:P184296 a rdf:Property ;
    rdfs:label "material accessible"@en ;
    dcterms:created "2026-01-13T14:59:06.008111+01:00"^^xsd:dateTime ;
    dcterms:identifier "P184296" ;
    rdfs:comment "Material Accessible refers to whether the research materials, such as datasets, software, experimental protocols, or other resources used or produced in the research, are made available and accessible to other researchers or the public. This property indicates the openness and reproducibility of the research by enabling others to access and utilize the materials for verification, replication, or further study."@en ;
    rdfs:isDefinedBy <https://w3id.org/orkg-properties-ontology-consolidated> ;
    skos:prefLabel "material accessible"@en .

orkg:P184298 a rdf:Property ;
    rdfs:label "type of theory"@en ;
    dcterms:created "2026-01-13T15:04:59.533371+01:00"^^xsd:dateTime ;
    dcterms:identifier "P184298" ;
    rdfs:comment "Type of Theory refers to the classification or category of the theoretical framework or model that a research paper develops, applies, or evaluates. It helps to specify whether the theory is, for example, a conceptual theory, mathematical theory, computational theory, or empirical theory, among others. This property is salient as it highlights the nature of the theoretical contribution made by the research, aiding in understanding the approach and foundation of the study."@en ;
    rdfs:isDefinedBy <https://w3id.org/orkg-properties-ontology-consolidated> ;
    skos:prefLabel "type of theory"@en .

orkg:P184299 a rdf:Property ;
    rdfs:label "formal theory"@en ;
    dcterms:created "2026-01-13T15:05:44.452690+01:00"^^xsd:dateTime ;
    dcterms:identifier "P184299" ;
    rdfs:comment "Formal Theory refers to the use or development of rigorous, mathematical, or logical frameworks to explain, predict, or analyze phenomena within a research paper. It involves the creation or application of abstract models, axioms, and formal reasoning to provide a structured and precise understanding of the subject matter."@en ;
    rdfs:isDefinedBy <https://w3id.org/orkg-properties-ontology-consolidated> ;
    skos:prefLabel "formal theory"@en .

