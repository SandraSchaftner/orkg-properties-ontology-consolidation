    dcterms:created "2026-01-13T15:08:07.018737+01:00"^^xsd:dateTime ;
    dcterms:identifier "P184302" ;
    rdfs:comment "Emphasis refers to the particular aspect, topic, or element that the research paper highlights or focuses on as its main contribution or area of interest. It identifies what the authors consider most important or central in their study."@en ;
    rdfs:isDefinedBy <https://w3id.org/orkg-properties-ontology-consolidated> ;
    skos:prefLabel "emphasis"@en .

