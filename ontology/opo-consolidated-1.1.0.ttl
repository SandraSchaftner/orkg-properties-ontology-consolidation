orkg:P191010 a rdf:Property ;
    rdfs:label "integration mechanism"@en ;
    dcterms:created "2026-04-19T05:52:11.417481+02:00"^^xsd:dateTime ;
    dcterms:identifier "P191010" ;
    rdfs:comment "The architectural approach used to enable interaction between a Large Language Model and external tools, including how tools are discovered, invoked, and embedded into the model’s workflow across different systems and paradigms."@en ;
    rdfs:isDefinedBy <https://w3id.org/orkg-properties-ontology-consolidated> ;
    skos:prefLabel "integration mechanism"@en .

orkg:P191011 a rdf:Property ;
    rdfs:label "communication protocol"@en ;
    dcterms:created "2026-04-19T06:05:46.198915+02:00"^^xsd:dateTime ;
    dcterms:identifier "P191011" ;
    rdfs:comment "Communication Protocol refers to the set of rules and conventions used for data exchange between the LLM and external tools. It defines how messages are structured, transmitted, and interpreted, ensuring interoperability, reliability, and efficiency. In the context of research, this property highlights the role of communication standards in enabling integration, such as proposing new protocols, adapting existing ones, or optimizing communication for performance and scalability."@en ;
    rdfs:isDefinedBy <https://w3id.org/orkg-properties-ontology-consolidated> ;
    skos:prefLabel "communication protocol"@en .

orkg:P191012 a rdf:Property ;
    rdfs:label "security model"@en ;
    dcterms:created "2026-04-19T06:07:14.739677+02:00"^^xsd:dateTime ;
    dcterms:identifier "P191012" ;
    rdfs:comment "Security Model refers to the set of mechanisms and principles used to ensure the protection of systems, data, and interactions in LLM-tool integration environments. It encompasses authentication, authorization, isolation, and monitoring strategies that prevent unauthorized access, misuse, or adversarial exploitation. In the context of research, this property highlights how security is enforced within the proposed approach, such as introducing novel protection mechanisms, strengthening existing safeguards, or analyzing vulnerabilities related to tool usage."@en ;
    rdfs:isDefinedBy <https://w3id.org/orkg-properties-ontology-consolidated> ;
    skos:prefLabel "security model"@en .

