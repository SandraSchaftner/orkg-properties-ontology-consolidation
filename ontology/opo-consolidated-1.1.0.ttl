orkg:P119133 a rdf:Property ;
    rdfs:label "pretraining compute (petaflops-days)"@en ;
    dcterms:created "2023-08-02T10:39:33.595727+02:00"^^xsd:dateTime ;
    dcterms:identifier "P119133" ;
    rdfs:comment "FLOPs (Floating Point Operations) is a measure of computational performance, and PetaFLOPs represents one quadrillion (10^15) floating-point operations per second. In the context of language models like GPT-3, pretraining involves a significant amount of computation to train the model on a large corpus of text data, and the \"PF-days\" metric quantifies the total computational power used for pretraining, typically measured in PetaFLOPs multiplied by the number of days the computation took."@en ;
    rdfs:isDefinedBy <https://w3id.org/orkg-properties-ontology-consolidated> ;
    skos:prefLabel "pretraining compute (petaflops-days)"@en .

